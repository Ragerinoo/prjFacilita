# Apenas nomes de variáveis. Nunca coloque valores neste arquivo.
# Copie para .env (ignorado pelo Git) e preencha localmente.

# AWS
AWS_PROFILE=
AWS_REGION=
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=

# Painel_CS: senha inicial dos usuários criados por script (troca forçada no primeiro acesso)
# Lida por scripts/criar_usuarios_cs.py (mínimo de 12 caracteres); nunca é impressa nem gravada
CS_SENHA_INICIAL=
# Prefixo das tabelas DynamoDB usado pelos scripts (padrão: tres)
TRES_PREFIXO_TABELAS=

# Agente / Base_Conhecimento
AGENTCORE_RUNTIME_ARN=
BEDROCK_MODEL_ID=
KNOWLEDGE_BASE_ID=
